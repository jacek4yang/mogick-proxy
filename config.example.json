{
  "server": {
    "bind": "127.0.0.1:8787",
    "api_key": ""
  },
  "upstream": {
    "base_url": "https://copilot.tongyuan.cc",
    "api_prefix": "/api/v1",
    "timeout_secs": 120,
    "extra_headers": {
      "X-App-Id": "mogick"
    }
  },
  "runtime": {
    "refresh_skew_secs": 60,
    "balance_poll_secs": 180,
    "max_request_bytes": 33554432,
    "log_level": "info",
    "log_format": "pretty"
  }
}
