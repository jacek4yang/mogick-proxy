# Source this file in the shell used to start a new Claude Code process.
# It does not read or modify ~/.claude or a project's .claude directory.
export ANTHROPIC_BASE_URL=http://127.0.0.1:8787

# Replace this with server.api_key when one is configured. A non-empty
# placeholder is sufficient only for a loopback server with an empty api_key.
export ANTHROPIC_AUTH_TOKEN=local-only

# The same tested model is used for every Claude Code role by default. Change
# individual aliases when another upstream model has been validated.
export ANTHROPIC_MODEL=sonnet
export ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-flash
export ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-flash
export ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
export ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES='effort,thinking,adaptive_thinking,interleaved_thinking'
export ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES='effort,thinking,adaptive_thinking,interleaved_thinking'
export ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES='effort,thinking,adaptive_thinking,interleaved_thinking'

export ANTHROPIC_CUSTOM_MODEL_OPTION=deepseek-v4-flash
export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME='DeepSeek V4 Flash via mogick'
export ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION='Anthropic Messages through mogick-provider'
export ANTHROPIC_CUSTOM_MODEL_OPTION_SUPPORTED_CAPABILITIES='effort,thinking,adaptive_thinking,interleaved_thinking'

# Populate Claude Code's model picker from GET /v1/models.
export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1

# Claude Code otherwise assumes a conservative window for an unrecognized
# gateway model ID. DeepSeek V4 Flash's published context window is 1,000,000
# tokens. Change this value when selecting a different upstream model or when
# the provider exposes a smaller deployment limit. Do not append [1m] unless
# the upstream actually accepts that suffix as part of its model ID.
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=1000000

# Coding turns and large tool results can legitimately take several minutes.
export API_TIMEOUT_MS=600000
